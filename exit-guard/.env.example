# KeeperHub
KEEPERHUB_API_KEY=kh_your_key_here
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_WALLET_ADDRESS=0x...      # from get_wallet_integration — this is the executor's keeper
EXIT_WORKFLOW_ID=                    # optional, if using the workflow path

# Chain
BASE_RPC_URL=https://mainnet.base.org
EXECUTOR_ADDRESS=0x...               # from scripts/deploy.ts

# Economics
DEFAULT_FEE_BPS=30
DEFAULT_SLIPPAGE_BPS=300

# x402 — agents pay Base USDC per exit call (evaluate stays free)
# X402_ENABLED defaults to true unless set to "false"
# X402_PAY_TO defaults to KEEPERHUB_WALLET_ADDRESS if omitted
X402_ENABLED=true
X402_PAY_TO=0xYourReceivingWalletOnBase
# Human dollars ("0.02" or "$0.02") OR atomic USDC units ("20000")
X402_CALL_PRICE_USDC=0.02
# Mainnet: https://facilitator.payai.network  (or Coinbase CDP)
# Testnet only: https://x402.org/facilitator
X402_FACILITATOR_URL=https://facilitator.payai.network

# Router thresholds
ROUTER_BASEFEE_GWEI=0.05
ROUTER_SLIPPAGE_ALERT_BPS=150
ROUTER_FAILURE_CEILING=2
ROUTER_LARGE_NOTIONAL_WETH=0.25

PORT=8787
